// ==========================================
// CẤU HÌNH KẾT NỐI (Yêu cầu Prisma 5.1+ để dùng extensions)
// ==========================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Bật tính năng nhận diện extension
}

datasource db {
  provider   = "postgresql"
  //url        = env("DATABASE_URL")
  extensions = [vector] // Kích hoạt pgvector
}

// ==========================================
// 1. CÁC THỰC THỂ CHÍNH (BASE MODELS)
// ==========================================

model User {
  id         Int       @id @default(autoincrement())
  username   String    @db.VarChar(100)
  displayName String?  @db.VarChar(100)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  dob        DateTime? @db.Date
  country    String?   @db.VarChar(100)
  avatarUrl     String?   @db.VarChar(500)
  coverImageUrl String?   @db.VarChar(500)
  bio           String?   @db.Text
  socialLinks   Json      @default("[]")
  isAdmin       Boolean   @default(false)
  isActive      Boolean   @default(true)
  role          String    @default("user") // phan quyen user - admin
  isVerified    Boolean   @default(false) // xac thuc account
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?                    // lan dang nhap gan nhat
  //vector luu tru User Factor tu CB 
  contentVector Unsupported("vector(128)")?
  // Vector lưu trữ User Factors từ ALS (Giả sử số chiều k = 64)
  collaborativeVector Unsupported("vector(64)")?

  // Quan hệ
  artist              Artist?
  artistRequest       ArtistRequest?
  playlists           Playlist[]
  collaborativePlaylists PlaylistCollaborator[]
  follows             Follow[]              @relation("Follower")
  followedBy          Follow[]              @relation("Followee")
  interactions        Interaction[]
  recommendationCache RecommendationCache[]
  notifications       Notification[]
  reports             Report[]
  likes               SongLike[]
  uploadedSongs       Song[]                @relation("UserUploadedSongs")
}

model Artist {
  userId       Int     @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedTick Boolean @default(false)

  followerCount Int @default(0) // hien fl cho frontend
  status String @default("active") // trang thai artist active -banned - pending
  pinnedSongId Int? // Bài hát được ghim
  pinnedSong   Song? @relation("ArtistPinnedSong", fields: [pinnedSongId], references: [id], onDelete: SetNull)

  albums Album[]
  songs  ArtistSong[]
}

model Playlist {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  coverArtUrl String?  @db.VarChar(500)
  playlistUrl String   @unique @db.VarChar(255)
  isPublic    Boolean  @default(true)
  isCollaborative Boolean  @default(false)

  // System Playlist fields
  isSystem    Boolean  @default(false)
  isOnHomepage Boolean  @default(false)
  displayOrder Int      @default(0)
  category    String?  @db.VarChar(100)

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  songs PlaylistSong[]
  collaborators PlaylistCollaborator[]
}

model Album {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  type         String?   @db.VarChar(50)
  coverArtUrl  String?   @db.VarChar(500)
  releasedDate DateTime? @db.Date
  scheduledAt  DateTime?
  status       String    @default("draft") @db.VarChar(50) // draft, scheduled, released
  createdAt    DateTime  @default(now())
  artistId     Int
  artist       Artist    @relation(fields: [artistId], references: [userId], onDelete: Cascade)

  songs AlbumSong[]
}

model Song {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  artistName  String?  @db.VarChar(255) // Tên nghệ sĩ do người upload nhập (metadata, không tạo Artist record)
  uploadedById Int?    
  uploadedBy   User?    @relation("UserUploadedSongs", fields: [uploadedById], references: [id], onDelete: SetNull)
  energy      Float? // Đổi sang Float để Node.js/Python tính toán không cần parse
  tempo       Float? // Đổi sang Float
  danceability Float? 
  status String @default("pending") @db.VarChar(50) // moi bai upload moi se tu pending
  // Vector lưu trữ Item Features (Cho CBF hoặc Item Factors của ALS)
  contentVector Unsupported("vector(128)")?

  // Vector luu tru Collaborative Filtering Vector ("ITEM FACETOR")
  collaborativeVector Unsupported("vector(64)")?

  // Streaming URLs
  audioUrl    String   @db.VarChar(500)
  coverArtUrl String?  @db.VarChar(500)
  durationMs  Int
  lyrics      String?  @db.Text
  playCount Int @default(0) // luot nghe- top trending - query nhanh
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Quan hệ
  genres              SongGenre[]
  albums              AlbumSong[]
  interactions        Interaction[]
  playlists           PlaylistSong[]
  artists             ArtistSong[]
  charts              ChartSong[]
  recommendationCache RecommendationCache[]
  likes               SongLike[]
  pinnedByArtists     Artist[] @relation("ArtistPinnedSong")

  // Tối ưu câu lệnh WHERE isDeleted = false khi quét toàn bộ bảng
  @@index([isDeleted])
  @@index([status])
  @@index([createdAt])
}

model Genre {
  id       Int    @id @default(autoincrement())
  genreTag String @unique @db.VarChar(100)

  songs SongGenre[]
}

model Chart {
  id        Int      @id @default(autoincrement())
  title     String?  @db.VarChar(255)
  chartType String?  @db.VarChar(100)
  updateAt  DateTime @default(now())

  songs ChartSong[]
}

// ==========================================
// 2. CÁC BẢNG TRUNG GIAN & HỆ THỐNG GỢI Ý
// ==========================================

// Bảng lưu trữ kết quả chạy ngầm từ Python API
model RecommendationCache {
  id         Int      @id @default(autoincrement())
  userId     Int
  songId     Int
  finalScore Float // Điểm gợi ý đã được tổng hợp (ALS + Content Based)
  updatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  // Tối ưu việc lấy Top N bài hát có điểm cao nhất cho 1 user
  @@index([userId, finalScore(sort: Desc)])
  
  // Đảm bảo không insert trùng 1 bài nhiều lần cho 1 user trong cache
  @@unique([userId, songId])
}

model Follow {
  followerId Int
  followeeId Int
  follower   User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
}

model Interaction {
  userId         Int
  songId         Int
  timeStamp      DateTime @default(now())
  completionRate Float?   // Tính bằng: durationPlayed / tổng thời lượng bài hát
  isLiked        Boolean  @default(false)
  isSkipped      Boolean  @default(false) // Bổ sung cờ đánh dấu bấm Next
  durationPlayed Int?
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song           Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  // Khóa chính đảm bảo lưu được mọi sự kiện nghe lại (Replay)
  @@id([userId, songId, timeStamp])

  @@index([userId, timeStamp])
  @@index([userId, songId])
  @@index([timeStamp])
}

model PlaylistSong {
  playlistId Int
  songId     Int
  sortOrder  Int      @default(0)
  addAt      DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
}

model ArtistSong {
  artistId Int
  songId   Int

  artist Artist @relation(fields: [artistId], references: [userId], onDelete: Cascade)
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([artistId, songId])
}

model AlbumSong {
  albumId  Int
  songId   Int
  position Int @default(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([albumId, songId])
}

model SongGenre {
  songId  Int
  genreId Int

  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([songId, genreId])
}

model ChartSong {
  chartId    Int
  songId     Int
  totalScore Float? // Đổi sang Float
  rank       Int?
  chart      Chart  @relation(fields: [chartId], references: [id], onDelete: Cascade)
  song       Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([chartId, songId])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  purpose   String   @db.VarChar(50)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ArtistRequest {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistName   String   @db.VarChar(255)
  idCardUrl    String   @db.VarChar(500)
  demoTrackUrl String   @db.VarChar(500)
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?  @db.Text
  createdAt    DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  type      String   @default("info") @db.VarChar(50) // info, artist_approved, artist_rejected, new_album, new_song
  targetType String?  @db.VarChar(50)
  targetId   Int?
  actionUrl  String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String   @db.VarChar(50) // 'SONG', 'ALBUM', 'ARTIST'
  targetId    Int      // ID của đối tượng bị báo cáo
  reason      String   @db.VarChar(100) // 'COPYRIGHT', 'SPAM', 'HATE_SPEECH'
  description String?  @db.Text
  proofUrl    String?  @db.VarChar(500) // Link chứng minh
  status      String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model SongLike {
  userId    Int
  songId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}

model PlaylistCollaborator {
  playlistId Int
  userId     Int
  createdAt  DateTime @default(now())

  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
}
