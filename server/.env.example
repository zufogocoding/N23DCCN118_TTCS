# ==========================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU (DATABASE CONFIG)
# ==========================================
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=soundclown
DB_HOST=db

# Đường dẫn kết nối CSDL dành cho Prisma
# Chạy với Docker: postgresql://your_db_user:your_db_password@db:5432/soundclown?schema=public
# Chạy thủ công local: postgresql://your_db_user:your_db_password@localhost:5433/soundclown?schema=public
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5433/soundclown?schema=public"

# ==========================================
# CẤU HÌNH XÁC THỰC & BẢO MẬT (AUTH & SECURITY)
# ==========================================
# Khóa bí mật dùng để mã hóa JSON Web Token
JWT_SECRET="your_jwt_secret_key_here"

# ==========================================
# CẤU HÌNH EMAIL GỬI OTP (EMAIL SERVICE CONFIG)
# ==========================================
# Địa chỉ Gmail dùng để gửi mã xác thực tài khoản (OTP)
EMAIL_USER="your-email@gmail.com"
# Mật khẩu ứng dụng Gmail (App Password, không phải mật khẩu chính)
EMAIL_PASS="your_gmail_app_password"
